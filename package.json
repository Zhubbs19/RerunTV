{
  "name": "retro-cable-box-foss",
  "version": "0.1.1",
  "description": "A retro broadcast cable box simulator with custom channels pulled from your own media library.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "electron . --headless",
    "test": "node scripts/run-tests.js",
    "test:contracts": "node scripts/validate-plugin-contracts.js",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "pack:personal": "set RERUNTV_INCLUDE_LOCAL_PLUGINS=1&& electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "busboy": "^1.6.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  }
}
