{
  "name": "retro-cable-box-foss",
  "version": "0.1.0",
  "description": "A retro broadcast cable box simulator with custom channels pulled from your own media library.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "electron . --headless",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "busboy": "^1.6.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.retrocablebox.foss",
    "productName": "RerunTV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*.js",
      "renderer/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "plugins/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Zhubbs19",
      "repo": "RerunTV",
      "private": true
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
