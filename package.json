{
  "name": "reruntv",
  "version": "0.2.0",
  "description": "A retro broadcast cable box simulator with custom channels pulled from your own media library.",
  "homepage": "https://github.com/Zhubbs19/RerunTV#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhubbs19/RerunTV.git"
  },
  "bugs": {
    "url": "https://github.com/Zhubbs19/RerunTV/issues"
  },
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "electron . --server",
    "headless": "electron . --headless",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "lint": "eslint .",
    "test:contracts": "node scripts/validate-plugin-contracts.js",
    "docs": "node scripts/build-docs.js",
    "site": "vite build --config site/vite.config.mjs",
    "site:dev": "vite --config site/vite.config.mjs",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "pack:personal": "node scripts/pack-personal.js",
    "dist": "electron-builder --config electron-builder.config.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.14.0",
    "espree": "^11.2.0",
    "fast-check": "4.10.2",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "author": "Zach Hubbard",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "busboy": "^1.6.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  }
}
