# One-off audit / probe / sweep scripts in tests/ui/. These are explicit scratch
# patterns, not a blanket *.mjs rule, so a new harness file (tests/ui/lib/*.mjs,
# run-ui-tests.mjs, ...) shows up in `git status` and can be added normally.
# Files already tracked (some verify-*.mjs and theme-*.mjs) are unaffected.
tests/ui/audit-*.mjs
tests/ui/check-*.mjs
tests/ui/cosmetic-*.mjs
tests/ui/current-*.mjs
tests/ui/debug-*.mjs
tests/ui/diff-*.mjs
tests/ui/flip-*.mjs
tests/ui/fullaudit-*.mjs
tests/ui/hold-*.mjs
tests/ui/livepass-*.mjs
tests/ui/make-*.mjs
tests/ui/measure-*.mjs
tests/ui/probe-*.mjs
tests/ui/quick-*.mjs
tests/ui/shot-*.mjs
tests/ui/sweep-*.mjs
tests/ui/ui-*.mjs
tests/ui/visual-*.mjs
tests/ui/verify-*.mjs
tests/ui/theme-*.mjs
tests/ui/_tmp_*

# ---------- Runtime logs (written by Electron / npm scripts) ----------
electron-launch.log
electron-launch-err.log
test_stdout.log
test_stderr.log

# ---------- Local convenience launchers ----------
# Devs create their own from README; committed versions (run-headless.bat)
# are the only ones that belong in the repo.
run-app.bat
run-server.bat
# run-server.bat ships (electron-builder extraFiles) and is tracked.
!run-server.bat

# ---------- tests/ui harness ----------
# The shared harness lives in tests/ui/:
#   README.md, lib/, fixtures/, run-ui-tests.*, theme-visual-sweep.*,
#   the tracked verify-*.mjs/js files (new ones stay local unless added with -f).
# Everything below is run output, personal audit work, or one-off scripts
# that belong only on the developer's own machine.

# Run output — screenshots, JSON reports, per-run logs
tests/ui/screenshots/
tests/ui/theme-sweep-screenshots/
tests/ui/results.json
tests/ui/report.json
tests/ui/*-report.json
tests/ui/*-out/
tests/ui/*.png
tests/ui/*.log

# Temporary / scratch files
tests/ui/_tmp_*
tests/ui/userData.test-backup/
# run-ui-tests.ps1 parks the real userData here during a run
/userData.test-backup/

# Dated audit sessions and their data files (subdirs and loose files)
tests/ui/audit/
tests/ui/audit-*/
tests/ui/audit-*.*

# Personal/one-off verify scripts not part of the main harness
# (.mjs ones are caught by the explicit patterns above; these are the .ps1 and
# .js variants that aren't)
tests/ui/verify-music-*.ps1
tests/ui/run-repeated-jump-test.ps1
tests/ui/run-*-cadence-test.ps1

# Profile captures and temporary harness directories
tests/ui/failed-profile-*/
tests/ui/failed-sweep-profile-*/
tests/ui/startup-login-harness/

# Bulk data / accumulated log files
tests/ui/doc*-out/
tests/ui/doc*-sweep/
tests/ui/break-sync-out/
tests/ui/companion-out/
tests/ui/repo-channels-before-*.json
tests/ui/theme-interaction-contrast-report.json

