<?xml version="1.0" encoding="utf-8"?>
<!-- Google TV home-screen banner (320x180dp — 16:9, referenced by
     AndroidManifest.xml's android:banner). Reuses ic_launcher_foreground's
     exact path data unchanged inside a translating <group> rather than
     hand-recalculating coordinates for the wider canvas — the glyph's
     bounding box is roughly 68x77 within its own 108x108 local space;
     translating by (106, 36) centers it in the 320x180 banner
     ((320-108)/2=106, (180-108)/2=36). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path android:fillColor="@color/launcher_background" android:pathData="M0,0h320v180h-320z" />
    <group android:translateX="106" android:translateY="36">
        <path
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M40,40 L26,16" />
        <path
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M68,40 L82,16" />
        <path android:fillColor="@color/launcher_foreground" android:pathData="M23,13 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
        <path android:fillColor="@color/launcher_foreground" android:pathData="M79,13 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
        <path android:fillColor="@color/launcher_foreground" android:pathData="M20,38 h68 a6,6 0 0 1 6,6 v34 a6,6 0 0 1 -6,6 h-68 a6,6 0 0 1 -6,-6 v-34 a6,6 0 0 1 6,-6 z" />
        <path android:fillColor="@color/launcher_background" android:pathData="M30,47 h48 v28 h-48 z" />
        <path android:fillColor="@color/launcher_foreground" android:pathData="M68,66 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
        <path android:fillColor="@color/launcher_foreground" android:pathData="M46,84 h16 v6 h-16 z" />
    </group>
</vector>
