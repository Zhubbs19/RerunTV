<?xml version="1.0" encoding="utf-8"?>
<!-- A nested settings group one level down from card_bg.xml (this app's own
     addition; the desktop has no equivalent since its .panel grid is flat,
     but this app has to walk arbitrarily deep JSON). Flat ink-deep fill,
     same as the desktop's sunken inputs/selects (.panel-interval input/
     select, setup.css), so nesting reads as "inset into the panel" rather
     than another panel of its own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/panel_alt" />
    <stroke android:width="1dp" android:color="@color/border" />
    <corners android:radius="4dp" />
</shape>
