<?xml version="1.0" encoding="utf-8"?>
<!-- Matches .setup-tab-btn.active / the desktop's primary gold buttons:
     gradient-gold fill (4 CSS stops collapsed to Android's 3-stop
     <gradient>: #fbe969 to #f5d327 to #cba408, the middle #e3bc12 stop
     folded into the overall curve), border #c98914, radius-sm (3px). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_mid2" />
            <stroke android:width="1dp" android:color="#c98914" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/gold_top"
                android:centerColor="@color/gold_mid"
                android:endColor="@color/gold_bottom" />
            <stroke android:width="1dp" android:color="#c98914" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
