<?xml version="1.0" encoding="utf-8"?>
<!-- Matches .setup-tab-btn (setup.css): gradient-btn fill, 1px line-token
     border, radius-sm (3px) on the real tab bar; kept symmetric here since
     this drawable is reused for every plain button, not just a tab strip. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_top" />
            <stroke android:width="1dp" android:color="@color/gold" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/btn_top"
                android:centerColor="@color/btn_mid"
                android:endColor="@color/btn_bottom" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
