# Doxygen settings for RerunTV's code reference (only the settings that differ from Doxygen's
# defaults). Build it with `npm run docs` (scripts/build-docs.js), which also leaves out gitignored
# files such as local-only plugins and stamps the version. Running `doxygen` here works too.
# Output: docs/api/html/index.html.
#
# Doxygen can't read JavaScript, so .js/.mjs/.cjs files go through scripts/doxygen-filter.js. It
# turns declarations into C++ Doxygen can parse and the existing comments into their docs; its
# header says which comments count.

PROJECT_NAME           = RerunTV
PROJECT_BRIEF          = "A retro broadcast cable box simulator"
OUTPUT_DIRECTORY       = docs/api
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
EXTENSION_MAPPING      = js=C++ mjs=C++ cjs=C++
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         CLAUDE.md \
                         PLUGIN_DEVELOPMENT.md \
                         CONTRIBUTING.md \
                         SECURITY.md \
                         RELEASING.md \
                         THIRD_PARTY_NOTICES.md \
                         docs/design \
                         main \
                         renderer/js \
                         plugins \
                         plugin-dev-kit
FILE_PATTERNS          = *.js *.mjs *.cjs *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */node_modules/* *.min.js
FILTER_PATTERNS        = "*.js=node scripts/doxygen-filter.js" \
                         "*.mjs=node scripts/doxygen-filter.js" \
                         "*.cjs=node scripts/doxygen-filter.js"
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_ID_STYLE      = GITHUB
IMAGE_PATH             = docs/screenshots

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
# The source pages show the real files: the filter keeps line numbers, and
# FILTER_SOURCE_FILES stays off.
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

# The website's look (site/src/style.css): dark only, since the site is. docs/doxygen/rerun.css
# restyles the pages; scripts/build-docs.js adds the site's header bar and recolors the graphs.
HTML_COLORSTYLE        = DARK
HTML_EXTRA_STYLESHEET  = docs/doxygen/rerun.css
HTML_EXTRA_FILES       = docs/doxygen/icon.png \
                         docs/doxygen/favicon.png
HTML_DYNAMIC_SECTIONS  = YES
# The design docs' ```mermaid blocks are drawn in the browser, by a pinned Mermaid release.
MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs

#---------------------------------------------------------------------------
# Graphs (Graphviz)
#---------------------------------------------------------------------------
# scripts/build-docs.js turns HAVE_DOT on when it finds Graphviz's dot. Doxygen draws only the folder
# graphs, from the #include the filter prints for each relative import. The file import graphs and the
# call, caller and class graphs come from scripts/doxygen-graphs.js, which reads the JavaScript itself
# (Doxygen's code parser loses a function's body after `export` and links calls by bare name) and
# lays them out for reading: grouped by file or folder, one step out, long lists summarized.
HAVE_DOT               = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_NUM_THREADS        = 0
DOT_COMMON_ATTR        = "fontname=\"Helvetica,Arial,sans-serif\",fontsize=10"
DOT_EDGE_ATTR          = "labelfontname=\"Helvetica,Arial,sans-serif\",labelfontsize=10"
DOT_GRAPH_MAX_NODES    = 150
MAX_DOT_GRAPH_DEPTH    = 2
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 1

